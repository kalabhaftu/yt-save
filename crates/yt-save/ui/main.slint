import { ComboBox, ListView } from "std-widgets.slint";

struct DownloadRowData {
    id: string,
    title: string,
    source: string,
    url: string,
    status: string,
    progress: float,
    detail: string,
    output-path: string,
    queue-position: string,
    priority: int,
    playlist-group-id: string,
    playlist-group-action: string,
}

struct PlaylistEntryRowData {
    row-index: int,
    ordinal: string,
    title: string,
    selectable: bool,
    selected: bool,
}

struct LibraryRowData {
    id: string,
    title: string,
    source: string,
    kind: string,
    file-format: string,
    file-path: string,
    file-status: string,
    size-label: string,
    downloaded-at: string,
    path-available: bool,
}

struct PlaylistSubscriptionRowData {
    id: string,
    title: string,
    source: string,
    url: string,
    summary: string,
    selected: bool,
}

struct PlaylistSubscriptionEntryRowData {
    media-key: string,
    title: string,
    detail: string,
    state: string,
    selectable: bool,
    selected: bool,
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> is-enabled: true;
    in property <length> button-height: 42px;
    in property <length> button-min-width: 112px;
    callback clicked();

    height: root.button-height;
    min-width: root.button-min-width;
    border-radius: 10px;
    background: primary ? #7968ff : #232638;
    opacity: is-enabled ? 1 : 0.45;
    border-width: primary ? 0px : 1px;
    border-color: #34384d;

    Text {
        text: label;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    TouchArea {
        enabled: root.is-enabled;
        clicked => { root.clicked(); }
    }
}

export component MainWindow inherits Window {
    in property <string> product-name: "Yt Save";
    in property <string> app-version: "0.1.14";
    title: root.product-name;
    preferred-width: 1180px;
    preferred-height: 800px;
    min-width: 800px;
    min-height: 620px;
    background: #0c0e15;

    in-out property <string> url-input: "";
    in-out property <bool> audio-only: false;
    in-out property <bool> subtitle-only: false;
    in-out property <string> subtitle-languages: "en";
    in-out property <string> subtitle-format: "vtt";
    in-out property <bool> include-auto-subtitles: false;
    in-out property <bool> schedule-download: false;
    in-out property <string> schedule-local-time: "";
    in-out property <string> audio-format: "original";
    in-out property <string> audio-quality: "best";
    in-out property <string> video-quality: "Best";
    in-out property <string> download-directory: "";
    in-out property <string> status-message: "Paste a media URL to get started.";
    in-out property <string> queue-summary: "No pending work";
    in property <bool> can-pause-all: false;
    in property <bool> can-resume-all: false;
    in property <bool> can-cancel-all: false;
    in property <bool> can-retry-failed: false;
    in-out property <bool> confirm-cancel-all: false;
    in-out property <string> max-concurrent-downloads: "1";
    in-out property <string> concurrent-fragments: "1";
    in-out property <string> auto-retry-attempts: "3";
    in-out property <string> history-search: "";
    in-out property <bool> show-library: false;
    in-out property <bool> show-subscriptions: false;
    in-out property <string> selected-subscription-id: "";
    in-out property <string> selected-subscription-title: "";
    in-out property <string> selected-subscription-details: "Choose a saved playlist to review its archive.";
    in-out property <string> subscription-selection-summary: "";
    in-out property <bool> subscription-checking: false;
    in-out property <int> playlist-subscription-selected-count: 0;
    in-out property <string> library-search: "";
    in-out property <string> library-filter: "All files";
    in-out property <string> library-sort: "Newest first";
    in-out property <bool> clipboard-monitoring-enabled: false;
    in-out property <string> clipboard-candidate: "";
    in-out property <bool> close-to-tray-enabled: false;
    in-out property <bool> minimize-to-tray-enabled: false;
    in-out property <string> dependency-status: "Checking bundled tools…";
    in-out property <bool> yt-dlp-update-in-progress: false;
    in-out property <string> analyzed-title: "";
    in-out property <string> analyzed-details: "";
    in-out property <bool> analyzed-is-playlist: false;
    in property <[PlaylistEntryRowData]> playlist-entries: [];
    in-out property <int> selected-playlist-count: 0;
    in-out property <int> selectable-playlist-count: 0;
    in-out property <string> playlist-selection-summary: "";
    in-out property <bool> show-playlist-range-controls: false;
    in-out property <string> playlist-range-start: "1";
    in-out property <string> playlist-range-end: "50";
    in property <[DownloadRowData]> downloads: [];
    in property <[LibraryRowData]> library-entries: [];
    in property <[PlaylistSubscriptionRowData]> playlist-subscriptions: [];
    in property <[PlaylistSubscriptionEntryRowData]> playlist-subscription-entries: [];

    callback analyze-requested(string);
    callback enqueue-requested(string);
    callback playlist-entry-toggle-requested(int);
    callback playlist-selection-set-requested(bool);
    callback playlist-range-selection-requested(string, string);
    callback enqueue-selected-playlist-entries-requested();
    callback subscribe-playlist-requested();
    callback subscriptions-view-requested(bool);
    callback playlist-subscription-selected-requested(string);
    callback playlist-subscription-check-requested(string);
    callback playlist-subscription-delete-requested(string);
    callback playlist-subscription-entry-toggle-requested(string);
    callback playlist-subscription-queue-selected-requested();
    callback playlist-subscription-dismiss-selected-requested();
    callback clipboard-monitoring-requested(bool);
    callback yt-dlp-update-requested();
    callback clipboard-candidate-dismissed();
    callback close-to-tray-requested(bool);
    callback minimize-to-tray-requested(bool);
    callback open-download-folder();
    callback choose-download-directory-requested();
    callback clear-completed-requested();
    callback pause-all-requested();
    callback resume-all-requested();
    callback cancel-all-requested();
    callback retry-all-failed-requested();
    callback export-history-requested();
    callback history-search-requested(string);
    callback library-search-requested(string);
    callback library-filter-requested(string);
    callback library-sort-requested(string);
    callback library-view-requested(bool);
    callback library-refresh-requested();
    callback cancel-download-requested(string);
    callback pause-download-requested(string);
    callback resume-download-requested(string);
    callback remove-download-requested(string);
    callback retry-download-requested(string);
    callback queue-move-requested(string, string);
    callback playlist-group-action-requested(string, string);
    callback download-priority-requested(string, int);
    callback max-concurrent-downloads-requested(string);
    callback concurrent-fragments-requested(string);
    callback auto-retry-attempts-requested(string);
    callback open-output-requested(string);
    callback reveal-output-requested(string);
    callback locate-library-file-requested(string);

    changed minimized => {
        if root.minimized && root.minimize-to-tray-enabled {
            root.hide();
        }
    }

    changed max-concurrent-downloads => {
        root.max-concurrent-downloads-requested(root.max-concurrent-downloads);
    }

    changed concurrent-fragments => {
        root.concurrent-fragments-requested(root.concurrent-fragments);
    }

    changed auto-retry-attempts => {
        root.auto-retry-attempts-requested(root.auto-retry-attempts);
    }

    changed history-search => {
        root.history-search-requested(root.history-search);
    }

    changed library-search => {
        root.library-search-requested(root.library-search);
    }

    changed library-filter => {
        root.library-filter-requested(root.library-filter);
    }

    changed library-sort => {
        root.library-sort-requested(root.library-sort);
    }

    changed show-library => {
        root.library-view-requested(root.show-library);
    }

    changed show-subscriptions => {
        root.subscriptions-view-requested(root.show-subscriptions);
    }

    VerticalLayout {
        spacing: 0px;

        Rectangle {
            height: 68px;
            background: #11141f;
            border-color: #202436;
            border-width: 0px;

            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;

                Image {
                    source: @image-url("../../../assets/yt-save.png");
                    width: 34px;
                    height: 34px;
                    image-fit: contain;
                }
                Text {
                    text: root.product-name;
                    color: #f3f4fa;
                    font-size: 20px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: "DOWNLOAD MANAGER";
                    color: #777f99;
                    font-size: 11px;
                    font-weight: 700;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 1px;
                    height: 22px;
                    background: #292e40;
                }
                Text {
                    text: "Windows desktop";
                    color: #8d95ac;
                    font-size: 12px;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            spacing: 0px;

            Rectangle {
                width: 220px;
                background: #10131d;
                border-color: #202436;
                border-width: 0px;

                VerticalLayout {
                    padding-top: 18px;
                    padding-bottom: 18px;
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;

                    Text {
                        text: "WORKSPACE";
                        color: #6e7690;
                        font-size: 10px;
                        font-weight: 700;
                        height: 30px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 42px;
                        border-radius: 9px;
                        background: !root.show-library && !root.show-subscriptions ? #23243a : #171b28;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text { text: "↓"; color: #a79aff; font-size: 18px; vertical-alignment: center; }
                            Text { text: "Downloads"; color: !root.show-library && !root.show-subscriptions ? #f4f2ff : #aab2c8; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.show-library = false; root.show-subscriptions = false; } }
                    }

                    Rectangle {
                        height: 42px;
                        border-radius: 9px;
                        background: root.show-library ? #23243a : #171b28;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text { text: "▣"; color: #a79aff; font-size: 16px; vertical-alignment: center; }
                            Text { text: "Library"; color: root.show-library ? #f4f2ff : #aab2c8; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.show-library = true; root.show-subscriptions = false; } }
                    }

                    Rectangle {
                        height: 42px;
                        border-radius: 9px;
                        background: root.show-subscriptions ? #23243a : #171b28;
                        HorizontalLayout {
                            padding-left: 12px;
                            spacing: 10px;
                            Text { text: "↻"; color: #a79aff; font-size: 17px; vertical-alignment: center; }
                            Text { text: "Subscriptions"; color: root.show-subscriptions ? #f4f2ff : #aab2c8; font-size: 14px; font-weight: 600; vertical-alignment: center; }
                        }
                        TouchArea { clicked => { root.show-library = false; root.show-subscriptions = true; } }
                    }

                    Rectangle { vertical-stretch: 1; }

                    Rectangle {
                        VerticalLayout {
                            spacing: 10px;
                            Rectangle {
                                border-radius: 12px;
                                background: #171b28;
                                border-width: 1px;
                                border-color: #282d40;
                                height: 150px;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    Text { text: "ENGINE STATUS"; color: #737b94; font-size: 10px; font-weight: 700; }
                                    Text {
                                        text: root.dependency-status;
                                        color: #aab2c8;
                                        font-size: 11px;
                                        wrap: word-wrap;
                                        vertical-stretch: 1;
                                    }
                                    ActionButton {
                                        label: root.yt-dlp-update-in-progress ? "Checking…" : "Check & install";
                                        is-enabled: !root.yt-dlp-update-in-progress;
                                        button-height: 28px;
                                        button-min-width: 150px;
                                        clicked => { root.yt-dlp-update-requested(); }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 12px;
                                background: #171b28;
                                border-width: 1px;
                                border-color: #282d40;
                                height: 124px;

                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 5px;
                                    Text { text: "CLIPBOARD ASSISTANT"; color: #737b94; font-size: 10px; font-weight: 700; }
                                    Text {
                                        text: root.clipboard-monitoring-enabled ? "Checks copied text locally. Nothing is analyzed or downloaded until you choose." : "Off by default. Turn on local checks for copied web links.";
                                        color: #aab2c8;
                                        font-size: 10px;
                                        wrap: word-wrap;
                                        vertical-stretch: 1;
                                    }
                                    ActionButton {
                                        label: root.clipboard-monitoring-enabled ? "Turn off" : "Turn on";
                                        primary: root.clipboard-monitoring-enabled;
                                        button-height: 28px;
                                        button-min-width: 112px;
                                        clicked => { root.clipboard-monitoring-requested(!root.clipboard-monitoring-enabled); }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: 12px;
                                background: #171b28;
                                border-width: 1px;
                                border-color: #282d40;
                                height: 112px;

                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 5px;
                                    Text { text: "TRAY BEHAVIOR"; color: #737b94; font-size: 10px; font-weight: 700; }
                                    ActionButton {
                                        label: root.close-to-tray-enabled ? "Close to tray: On" : "Close to tray: Off";
                                        primary: root.close-to-tray-enabled;
                                        button-height: 28px;
                                        button-min-width: 142px;
                                        clicked => { root.close-to-tray-requested(!root.close-to-tray-enabled); }
                                    }
                                    ActionButton {
                                        label: root.minimize-to-tray-enabled ? "Minimize to tray: On" : "Minimize to tray: Off";
                                        primary: root.minimize-to-tray-enabled;
                                        button-height: 28px;
                                        button-min-width: 142px;
                                        clicked => { root.minimize-to-tray-requested(!root.minimize-to-tray-enabled); }
                                    }
                                }
                            }
                        }
                    }
                    Text {
                        text: "VERSION " + root.app-version;
                        color: #626a82;
                        font-size: 10px;
                        height: 28px;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                background: #0c0e15;
                if root.show-library : VerticalLayout {
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 36px;
                    padding-right: 36px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 4px;
                            Text { text: "Library"; color: #f2f3f8; font-size: 27px; font-weight: 700; }
                            Text {
                                text: "Completed downloads, linked to their original files. Nothing is copied into a separate library.";
                                color: #8c94aa;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        ActionButton { label: "Refresh files"; clicked => { root.library-refresh-requested(); } }
                        ActionButton { label: "Open download folder"; clicked => { root.open-download-folder(); } }
                    }

                    HorizontalLayout {
                        height: 38px;
                        spacing: 10px;
                        Rectangle {
                            border-radius: 8px;
                            background: #0e111a;
                            border-width: 1px;
                            border-color: #343a4e;
                            horizontal-stretch: 1;
                            TextInput {
                                text <=> root.library-search;
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                accessible-placeholder-text: "Search title, source, or file path";
                                color: #ecedf4;
                                font-size: 12px;
                                selection-background-color: #5751a3;
                                vertical-alignment: center;
                            }
                            if root.library-search == "" : Text {
                                x: 10px;
                                width: parent.width - 20px;
                                height: parent.height;
                                text: "Search title, source, or file path";
                                color: #727b92;
                                font-size: 12px;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                        ComboBox {
                            model: ["All files", "Video", "Audio", "Subtitles", "Missing files"];
                            current-value <=> root.library-filter;
                            width: 136px;
                            height: 34px;
                        }
                        ComboBox {
                            model: ["Newest first", "Oldest first", "Title A–Z", "Largest first"];
                            current-value <=> root.library-sort;
                            width: 150px;
                            height: 34px;
                        }
                    }

                    Rectangle {
                        background: #10131c;
                        border-width: 1px;
                        border-color: #252a3a;
                        border-radius: 13px;
                        vertical-stretch: 1;
                        if root.library-entries.length == 0 : VerticalLayout {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            alignment: center;
                            spacing: 8px;
                            Text { text: root.library-search == "" && root.library-filter == "All files" ? "No completed media yet" : "No matching files"; color: #d9dce7; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                            Text { text: root.library-search == "" ? "Completed downloads appear here and stay in their saved locations." : "Try another title, source, path, or file filter."; color: #778099; font-size: 12px; horizontal-alignment: center; }
                        }
                        if root.library-entries.length > 0 : ListView {
                            x: 8px;
                            y: 8px;
                            width: parent.width - 16px;
                            height: parent.height - 16px;
                            for entry in root.library-entries : Rectangle {
                                height: 92px;
                                background: #10131c;
                                border-color: #202536;
                                border-width: 0px;
                                HorizontalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 48px;
                                        height: 48px;
                                        border-radius: 10px;
                                        background: #22263a;
                                        Text { text: entry.kind == "Audio" ? "♫" : "▶"; color: #aaa0ff; font-size: 17px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: entry.title; color: #e4e6ef; font-size: 13px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: entry.file-status; color: entry.path-available ? #74d6ae : #dfb86f; font-size: 11px; }
                                        }
                                        Text { text: entry.source + " · " + entry.kind + " · " + entry.file-format + " · " + entry.size-label + " · " + entry.downloaded-at; color: #9aa2b8; font-size: 10px; overflow: elide; }
                                        Text { text: entry.file-path; color: #757e97; font-size: 10px; overflow: elide; }
                                    }
                                    if entry.path-available : ActionButton {
                                        label: "Open";
                                        button-height: 30px;
                                        button-min-width: 60px;
                                        clicked => { root.open-output-requested(entry.file-path); }
                                    }
                                    if entry.path-available : ActionButton {
                                        label: "Show";
                                        button-height: 30px;
                                        button-min-width: 60px;
                                        clicked => { root.reveal-output-requested(entry.file-path); }
                                    }
                                    if !entry.path-available : ActionButton {
                                        label: "Locate file";
                                        button-height: 30px;
                                        button-min-width: 86px;
                                        clicked => { root.locate-library-file-requested(entry.id); }
                                    }
                                    ActionButton {
                                        label: "Remove";
                                        button-height: 30px;
                                        button-min-width: 64px;
                                        clicked => { root.remove-download-requested(entry.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                if root.show-subscriptions : VerticalLayout {
                    padding-top: 24px;
                    padding-bottom: 24px;
                    padding-left: 36px;
                    padding-right: 36px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 4px;
                            Text { text: "Playlist subscriptions"; color: #f2f3f8; font-size: 27px; font-weight: 700; }
                            Text {
                                text: "Check saved playlists manually. New entries wait here for your review; local files are never removed.";
                                color: #8c94aa;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        ActionButton {
                            label: root.subscription-checking ? "Checking…" : "Check now";
                            is-enabled: root.selected-subscription-id != "" && !root.subscription-checking;
                            clicked => { root.playlist-subscription-check-requested(root.selected-subscription-id); }
                        }
                        ActionButton {
                            label: "Queue selected";
                            primary: true;
                            is-enabled: root.playlist-subscription-selected-count > 0;
                            clicked => { root.playlist-subscription-queue-selected-requested(); }
                        }
                    }

                    HorizontalLayout {
                        spacing: 12px;
                        Rectangle {
                            width: 292px;
                            background: #10131c;
                            border-width: 1px;
                            border-color: #252a3a;
                            border-radius: 13px;
                            if root.playlist-subscriptions.length == 0 : VerticalLayout {
                                x: 12px;
                                y: 12px;
                                width: parent.width - 24px;
                                height: parent.height - 24px;
                                alignment: center;
                                spacing: 8px;
                                Text { text: "No saved playlists"; color: #d9dce7; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: "Analyze a playlist and choose Save subscription."; color: #778099; font-size: 11px; horizontal-alignment: center; wrap: word-wrap; }
                            }
                            if root.playlist-subscriptions.length > 0 : ListView {
                                x: 6px;
                                y: 6px;
                                width: parent.width - 12px;
                                height: parent.height - 12px;
                                for subscription in root.playlist-subscriptions : Rectangle {
                                    height: 82px;
                                    border-radius: 8px;
                                    background: subscription.selected ? #25243c : #10131c;
                                    VerticalLayout {
                                        padding: 10px;
                                        spacing: 4px;
                                        Text { text: subscription.title; color: #e4e6ef; font-size: 12px; font-weight: 600; overflow: elide; }
                                        Text { text: subscription.source + " · " + subscription.summary; color: #8c95ad; font-size: 10px; overflow: elide; }
                                        Text { text: subscription.url; color: #717a92; font-size: 9px; overflow: elide; }
                                    }
                                    TouchArea { clicked => { root.playlist-subscription-selected-requested(subscription.id); } }
                                }
                            }
                        }

                        Rectangle {
                            horizontal-stretch: 1;
                            background: #10131c;
                            border-width: 1px;
                            border-color: #252a3a;
                            border-radius: 13px;
                            VerticalLayout {
                                padding: 12px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        min-width: 0px;
                                        spacing: 3px;
                                        Text { text: root.selected-subscription-title == "" ? "Review new entries" : root.selected-subscription-title; color: #e4e6ef; font-size: 15px; font-weight: 600; overflow: elide; }
                                        Text { text: root.selected-subscription-details + " · " + root.subscription-selection-summary; color: #8c95ad; font-size: 10px; overflow: elide; }
                                    }
                                    ActionButton {
                                        label: "Dismiss selected";
                                        button-height: 32px;
                                        button-min-width: 120px;
                                        is-enabled: root.playlist-subscription-selected-count > 0;
                                        clicked => { root.playlist-subscription-dismiss-selected-requested(); }
                                    }
                                    ActionButton {
                                        label: "Remove";
                                        button-height: 32px;
                                        button-min-width: 72px;
                                        is-enabled: root.selected-subscription-id != "";
                                        clicked => { root.playlist-subscription-delete-requested(root.selected-subscription-id); }
                                    }
                                }
                                Rectangle {
                                    vertical-stretch: 1;
                                    background: #0d1017;
                                    border-width: 1px;
                                    border-color: #222737;
                                    border-radius: 9px;
                                    if root.playlist-subscription-entries.length == 0 : VerticalLayout {
                                        x: 8px;
                                        y: 8px;
                                        width: parent.width - 16px;
                                        height: parent.height - 16px;
                                        alignment: center;
                                        spacing: 7px;
                                        Text { text: root.selected-subscription-id == "" ? "Select a playlist" : "No archived entries yet"; color: #d9dce7; font-size: 14px; font-weight: 600; horizontal-alignment: center; }
                                        Text { text: "Choose Check now to look for playlist entries."; color: #778099; font-size: 11px; horizontal-alignment: center; }
                                    }
                                    if root.playlist-subscription-entries.length > 0 : ListView {
                                        x: 6px;
                                        y: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height - 12px;
                                        for entry in root.playlist-subscription-entries : Rectangle {
                                            height: 58px;
                                            background: entry.selected ? #1b1d2e : #0d1017;
                                            HorizontalLayout {
                                                padding-left: 10px;
                                                padding-right: 8px;
                                                spacing: 10px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    min-width: 0px;
                                                    alignment: center;
                                                    spacing: 3px;
                                                    Text { text: entry.title; color: #e4e6ef; font-size: 12px; font-weight: 600; overflow: elide; }
                                                    Text { text: entry.detail; color: #8c95ad; font-size: 10px; overflow: elide; }
                                                }
                                                Text { text: entry.state; color: entry.state == "New" ? #dfb86f : #8c95ad; font-size: 10px; }
                                                if entry.selectable : ActionButton {
                                                    label: entry.selected ? "Selected" : "Select";
                                                    button-height: 28px;
                                                    button-min-width: 72px;
                                                    clicked => { root.playlist-subscription-entry-toggle-requested(entry.media-key); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                if !root.show-library && !root.show-subscriptions : VerticalLayout {
                    padding-top: 20px;
                    padding-bottom: 20px;
                    padding-left: 36px;
                    padding-right: 36px;
                    spacing: 16px;

                    HorizontalLayout {
                        spacing: 12px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            min-width: 0px;
                            spacing: 4px;
                            Text { text: "Downloads"; color: #f2f3f8; font-size: 27px; font-weight: 700; }
                            Text {
                                text: "Save to " + root.download-directory;
                                color: #8c94aa;
                                font-size: 12px;
                                overflow: elide;
                            }
                        }
                        ActionButton {
                            label: "Choose folder";
                            button-min-width: 126px;
                            clicked => { root.choose-download-directory-requested(); }
                        }
                        ActionButton {
                            label: "Open folder";
                            clicked => { root.open-download-folder(); }
                        }
                    }

                    Rectangle {
                        height: 388px + (root.clipboard-candidate != "" ? 38px : 0px) + (root.subtitle-only ? 72px : 0px) + (root.schedule-download ? 38px : 0px);
                        background: #151925;
                        border-width: 1px;
                        border-color: #2a3043;
                        border-radius: 14px;

                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "New download"; color: #eff0f7; font-size: 15px; font-weight: 600; }
                            if root.clipboard-candidate != "" : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Copied URL"; color: #a9b0c4; font-size: 11px; }
                                Text {
                                    text: root.clipboard-candidate;
                                    color: #d6d9e5;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Use";
                                    button-height: 28px;
                                    button-min-width: 54px;
                                    clicked => {
                                        root.url-input = root.clipboard-candidate;
                                        root.clipboard-candidate = "";
                                    }
                                }
                                ActionButton {
                                    label: "Dismiss";
                                    button-height: 28px;
                                    button-min-width: 76px;
                                    clicked => { root.clipboard-candidate-dismissed(); }
                                }
                            }
                            HorizontalLayout {
                                spacing: 10px;
                                Rectangle {
                                    border-radius: 9px;
                                    background: #0e111a;
                                    border-width: 1px;
                                    border-color: #343a4e;
                                    horizontal-stretch: 1;
                                    TextInput {
                                        text <=> root.url-input;
                                        x: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        accessible-placeholder-text: "Paste a video, audio, playlist, or other supported media URL";
                                        color: #ecedf4;
                                        font-size: 13px;
                                        selection-background-color: #5751a3;
                                        vertical-alignment: center;
                                        accepted => { root.enqueue-requested(root.url-input); }
                                    }
                                    if root.url-input == "" : Text {
                                        x: 12px;
                                        width: parent.width - 24px;
                                        height: parent.height;
                                        text: "Paste a video, audio, playlist, or other supported media URL";
                                        color: #727b92;
                                        font-size: 13px;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                                ActionButton {
                                    label: "Analyze";
                                    clicked => { root.analyze-requested(root.url-input); }
                                }
                                ActionButton {
                                    label: "Add to queue";
                                    primary: true;
                                    clicked => { root.enqueue-requested(root.url-input); }
                                }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text {
                                    text: "Download mode";
                                    color: #a9b0c4;
                                    font-size: 11px;
                                    width: 92px;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Video";
                                    primary: !root.audio-only && !root.subtitle-only;
                                    button-height: 30px;
                                    button-min-width: 86px;
                                    clicked => { root.audio-only = false; root.subtitle-only = false; }
                                }
                                ActionButton {
                                    label: "Audio only";
                                    primary: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 102px;
                                    clicked => { root.audio-only = true; root.subtitle-only = false; }
                                }
                                ActionButton {
                                    label: "Subtitles";
                                    primary: root.subtitle-only;
                                    button-height: 30px;
                                    button-min-width: 98px;
                                    clicked => { root.audio-only = false; root.subtitle-only = true; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Text {
                                    text: "Video quality";
                                    color: #a9b0c4;
                                    font-size: 11px;
                                    width: 92px;
                                    vertical-alignment: center;
                                }
                                ComboBox {
                                    model: ["Best", "2160p / 4K", "1440p", "1080p", "720p", "480p", "360p", "Lowest"];
                                    current-value <=> root.video-quality;
                                    enabled: !root.audio-only && !root.subtitle-only;
                                    height: 34px;
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text {
                                    text: "Audio format";
                                    color: #a9b0c4;
                                    font-size: 11px;
                                    width: 92px;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Original";
                                    primary: root.audio-format == "original";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 82px;
                                    clicked => { root.audio-format = "original"; }
                                }
                                ActionButton {
                                    label: "MP3";
                                    primary: root.audio-format == "mp3";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "mp3"; }
                                }
                                ActionButton {
                                    label: "M4A";
                                    primary: root.audio-format == "m4a";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "m4a"; }
                                }
                                ActionButton {
                                    label: "Opus";
                                    primary: root.audio-format == "opus";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "opus"; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text {
                                    text: "Other formats";
                                    color: #a9b0c4;
                                    font-size: 11px;
                                    width: 92px;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "AAC";
                                    primary: root.audio-format == "aac";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "aac"; }
                                }
                                ActionButton {
                                    label: "ALAC";
                                    primary: root.audio-format == "alac";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "alac"; }
                                }
                                ActionButton {
                                    label: "FLAC";
                                    primary: root.audio-format == "flac";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "flac"; }
                                }
                                ActionButton {
                                    label: "Vorbis";
                                    primary: root.audio-format == "vorbis";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "vorbis"; }
                                }
                                ActionButton {
                                    label: "WAV";
                                    primary: root.audio-format == "wav";
                                    is-enabled: root.audio-only;
                                    button-height: 30px;
                                    button-min-width: 64px;
                                    clicked => { root.audio-format = "wav"; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text {
                                    text: "Audio quality";
                                    color: #a9b0c4;
                                    font-size: 11px;
                                    width: 92px;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Best";
                                    primary: root.audio-quality == "best";
                                    is-enabled: root.audio-only && root.audio-format != "original" && root.audio-format != "alac" && root.audio-format != "flac" && root.audio-format != "wav";
                                    button-height: 30px;
                                    button-min-width: 68px;
                                    clicked => { root.audio-quality = "best"; }
                                }
                                ActionButton {
                                    label: "320 kbps";
                                    primary: root.audio-quality == "320k";
                                    is-enabled: root.audio-only && root.audio-format != "original" && root.audio-format != "alac" && root.audio-format != "flac" && root.audio-format != "wav";
                                    button-height: 30px;
                                    button-min-width: 82px;
                                    clicked => { root.audio-quality = "320k"; }
                                }
                                ActionButton {
                                    label: "192 kbps";
                                    primary: root.audio-quality == "192k";
                                    is-enabled: root.audio-only && root.audio-format != "original" && root.audio-format != "alac" && root.audio-format != "flac" && root.audio-format != "wav";
                                    button-height: 30px;
                                    button-min-width: 82px;
                                    clicked => { root.audio-quality = "192k"; }
                                }
                                ActionButton {
                                    label: "128 kbps";
                                    primary: root.audio-quality == "128k";
                                    is-enabled: root.audio-only && root.audio-format != "original" && root.audio-format != "alac" && root.audio-format != "flac" && root.audio-format != "wav";
                                    button-height: 30px;
                                    button-min-width: 82px;
                                    clicked => { root.audio-quality = "128k"; }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "When"; color: #a9b0c4; font-size: 11px; width: 92px; vertical-alignment: center; }
                                ActionButton {
                                    label: "Start now";
                                    primary: !root.schedule-download;
                                    button-height: 28px;
                                    button-min-width: 92px;
                                    clicked => { root.schedule-download = false; }
                                }
                                ActionButton {
                                    label: "Schedule";
                                    primary: root.schedule-download;
                                    button-height: 28px;
                                    button-min-width: 92px;
                                    clicked => { root.schedule-download = true; }
                                }
                                Text { text: root.schedule-download ? "One time · local time" : ""; color: #727b92; font-size: 10px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            if root.schedule-download : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Local date/time"; color: #a9b0c4; font-size: 11px; width: 92px; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0e111a;
                                    border-width: 1px;
                                    border-color: #343a4e;
                                    border-radius: 8px;
                                    TextInput {
                                        text <=> root.schedule-local-time;
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        accessible-placeholder-text: "YYYY-MM-DD HH:MM";
                                        color: #ecedf4;
                                        font-size: 12px;
                                        selection-background-color: #5751a3;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "Format: YYYY-MM-DD HH:MM"; color: #727b92; font-size: 10px; vertical-alignment: center; }
                            }
                            if root.subtitle-only : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Languages"; color: #a9b0c4; font-size: 11px; width: 92px; vertical-alignment: center; }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: #0e111a;
                                    border-width: 1px;
                                    border-color: #343a4e;
                                    border-radius: 8px;
                                    TextInput {
                                        text <=> root.subtitle-languages;
                                        x: 10px;
                                        width: parent.width - 20px;
                                        height: parent.height;
                                        accessible-placeholder-text: "For example: en,fr";
                                        color: #ecedf4;
                                        font-size: 12px;
                                        selection-background-color: #5751a3;
                                        vertical-alignment: center;
                                    }
                                }
                                ActionButton {
                                    label: root.include-auto-subtitles ? "Auto captions: On" : "Auto captions: Off";
                                    primary: root.include-auto-subtitles;
                                    button-height: 28px;
                                    button-min-width: 132px;
                                    clicked => { root.include-auto-subtitles = !root.include-auto-subtitles; }
                                }
                            }
                            if root.subtitle-only : HorizontalLayout {
                                height: 30px;
                                spacing: 8px;
                                Text { text: "Subtitle format"; color: #a9b0c4; font-size: 11px; width: 92px; vertical-alignment: center; }
                                ActionButton {
                                    label: "SRT";
                                    primary: root.subtitle-format == "srt";
                                    button-height: 28px;
                                    button-min-width: 66px;
                                    clicked => { root.subtitle-format = "srt"; }
                                }
                                ActionButton {
                                    label: "VTT";
                                    primary: root.subtitle-format == "vtt";
                                    button-height: 28px;
                                    button-min-width: 66px;
                                    clicked => { root.subtitle-format = "vtt"; }
                                }
                                Text { text: "Analyze to see reported caption languages."; color: #727b92; font-size: 10px; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                            }
                            Text {
                                height: 12px;
                                text: root.schedule-download ? (root.subtitle-only ? "Yt Save must be running at the scheduled time. Captions are external sidecars." : "Yt Save must be running at the scheduled local time.") : root.subtitle-only ? "Captions are saved as external sidecar files; missing captions are reported as a failed queue item." : !root.audio-only ? "Video presets cap requested resolution; availability depends on site formats." : root.audio-format == "alac" || root.audio-format == "flac" || root.audio-format == "wav" ? "ALAC, FLAC, and WAV cannot restore quality already lost in a lossy source." : root.audio-format != "original" ? "Conversion requires bundled FFmpeg. Quality applies to lossy formats." : "Original keeps the source audio without conversion.";
                                color: #747d96;
                                font-size: 10px;
                                overflow: elide;
                            }
                            Text { text: root.status-message; color: #99a2ba; font-size: 12px; }
                        }
                    }

                    if root.analyzed-title != "" : Rectangle {
                        height: root.analyzed-is-playlist ? (root.show-playlist-range-controls ? 284px : 250px) : 92px;
                        background: #121722;
                        border-width: 1px;
                        border-color: #2a3041;
                        border-radius: 12px;
                        VerticalLayout {
                            padding-top: 14px;
                            padding-bottom: 14px;
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 6px;
                            Text { text: root.analyzed-title; color: #e9ebf4; font-size: 14px; font-weight: 600; }
                            Text { text: root.analyzed-details; color: #8c95ad; font-size: 12px; }
                            if root.analyzed-is-playlist : HorizontalLayout {
                                height: 34px;
                                spacing: 8px;
                                Text {
                                    text: root.playlist-selection-summary;
                                    color: #8c95ad;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Select all";
                                    button-height: 30px;
                                    button-min-width: 82px;
                                    is-enabled: root.selectable-playlist-count > root.selected-playlist-count;
                                    clicked => { root.playlist-selection-set-requested(true); }
                                }
                                ActionButton {
                                    label: "Select none";
                                    button-height: 30px;
                                    button-min-width: 90px;
                                    is-enabled: root.selected-playlist-count > 0;
                                    clicked => { root.playlist-selection-set-requested(false); }
                                }
                                ActionButton {
                                    label: root.show-playlist-range-controls ? "Hide range" : "Range…";
                                    button-height: 30px;
                                    button-min-width: 78px;
                                    clicked => { root.show-playlist-range-controls = !root.show-playlist-range-controls; }
                                }
                                ActionButton {
                                    label: "Add selected";
                                    button-height: 30px;
                                    min-width: 170px;
                                    primary: true;
                                    is-enabled: root.selected-playlist-count > 0 && !root.subtitle-only;
                                    clicked => { root.enqueue-selected-playlist-entries-requested(); }
                                }
                                ActionButton {
                                    label: "Save subscription";
                                    button-height: 30px;
                                    button-min-width: 126px;
                                    is-enabled: !root.subscription-checking;
                                    clicked => { root.subscribe-playlist-requested(); }
                                }
                            }
                            if root.analyzed-is-playlist && root.show-playlist-range-controls : HorizontalLayout {
                                height: 30px;
                                spacing: 6px;
                                Text { text: "Indexes"; color: #8c95ad; font-size: 10px; vertical-alignment: center; }
                                Rectangle {
                                    width: 58px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: #0e111a;
                                    border-width: 1px;
                                    border-color: #343a4e;
                                    TextInput {
                                        text <=> root.playlist-range-start;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        color: #ecedf4;
                                        font-size: 11px;
                                        selection-background-color: #5751a3;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "to"; color: #8c95ad; font-size: 10px; vertical-alignment: center; }
                                Rectangle {
                                    width: 58px;
                                    height: 28px;
                                    border-radius: 6px;
                                    background: #0e111a;
                                    border-width: 1px;
                                    border-color: #343a4e;
                                    TextInput {
                                        text <=> root.playlist-range-end;
                                        x: 6px;
                                        width: parent.width - 12px;
                                        height: parent.height;
                                        color: #ecedf4;
                                        font-size: 11px;
                                        selection-background-color: #5751a3;
                                        vertical-alignment: center;
                                    }
                                }
                                Text { text: "Select a range within the visible playlist preview."; color: #747d96; font-size: 10px; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                ActionButton {
                                    label: "Select range";
                                    button-height: 28px;
                                    button-min-width: 98px;
                                    clicked => { root.playlist-range-selection-requested(root.playlist-range-start, root.playlist-range-end); }
                                }
                            }
                            if root.analyzed-is-playlist : ListView {
                                height: root.show-playlist-range-controls ? 111px : 145px;
                                for entry in root.playlist-entries: Rectangle {
                                    height: 30px;
                                    background: entry.selected ? #22243a : #121722;
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        Text {
                                            text: entry.selectable ? (entry.selected ? "✓" : "□") : "—";
                                            color: entry.selectable ? #b7adff : #555d70;
                                            width: 24px;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                        Text {
                                            text: entry.ordinal + ". " + entry.title;
                                            color: entry.selectable ? #d6d9e5 : #71798e;
                                            font-size: 12px;
                                            overflow: elide;
                                            vertical-alignment: center;
                                            horizontal-stretch: 1;
                                        }
                                    }
                                    if entry.selectable : TouchArea {
                                            clicked => { root.playlist-entry-toggle-requested(entry.row-index); }
                                    }
                                }
                            }
                            if root.analyzed-is-playlist : Text {
                                text: "The preview is capped at 50 entries. Playlist items are queued only after you select them.";
                                color: #727b92;
                                font-size: 10px;
                            }
                        }
                    }

                    VerticalLayout {
                        height: 188px;
                        spacing: 4px;
                        HorizontalLayout {
                            height: 36px;
                            Text { text: "Queue"; color: #e9eaf1; font-size: 16px; font-weight: 600; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                            ActionButton {
                                label: "Export history";
                                clicked => { root.export-history-requested(); }
                            }
                            ActionButton {
                                label: "Clear completed";
                                clicked => { root.clear-completed-requested(); }
                            }
                            Text { text: root.queue-summary; color: #a1a8bb; font-size: 11px; vertical-alignment: center; }
                        }
                        HorizontalLayout {
                            height: 30px;
                            if root.confirm-cancel-all : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Cancel queued and active downloads? Partial files will be kept.";
                                    color: #dfb86f;
                                    font-size: 11px;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                ActionButton {
                                    label: "Confirm cancel";
                                    primary: true;
                                    button-height: 28px;
                                    button-min-width: 116px;
                                    clicked => {
                                        root.cancel-all-requested();
                                        root.confirm-cancel-all = false;
                                    }
                                }
                                ActionButton {
                                    label: "Keep downloads";
                                    button-height: 28px;
                                    button-min-width: 116px;
                                    clicked => { root.confirm-cancel-all = false; }
                                }
                            }
                            if !root.confirm-cancel-all : HorizontalLayout {
                                spacing: 6px;
                                ActionButton {
                                    label: "Pause all";
                                    is-enabled: root.can-pause-all;
                                    button-height: 28px;
                                    button-min-width: 86px;
                                    clicked => { root.pause-all-requested(); }
                                }
                                ActionButton {
                                    label: "Resume paused";
                                    is-enabled: root.can-resume-all;
                                    button-height: 28px;
                                    button-min-width: 108px;
                                    clicked => { root.resume-all-requested(); }
                                }
                                ActionButton {
                                    label: "Cancel all";
                                    is-enabled: root.can-cancel-all;
                                    button-height: 28px;
                                    button-min-width: 88px;
                                    clicked => { root.confirm-cancel-all = true; }
                                }
                                ActionButton {
                                    label: "Retry failed";
                                    is-enabled: root.can-retry-failed;
                                    button-height: 28px;
                                    button-min-width: 96px;
                                    clicked => { root.retry-all-failed-requested(); }
                                }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                        HorizontalLayout {
                            height: 36px;
                            Text { text: "Parallel downloads"; color: #a1a8bb; font-size: 11px; vertical-alignment: center; }
                            ComboBox {
                                model: ["1", "2", "3", "4", "5", "6", "7", "8"];
                                current-value <=> root.max-concurrent-downloads;
                                width: 74px;
                                height: 32px;
                            }
                            Text { text: "Fragments per download"; color: #a1a8bb; font-size: 11px; vertical-alignment: center; }
                            ComboBox {
                                model: ["1", "2", "3", "4", "5", "6", "7", "8"];
                                current-value <=> root.concurrent-fragments;
                                width: 64px;
                                height: 32px;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            height: 32px;
                            Text { text: "Automatic retries"; color: #a1a8bb; font-size: 11px; vertical-alignment: center; }
                            ComboBox {
                                model: ["Off", "1", "2", "3", "4", "5"];
                                current-value <=> root.auto-retry-attempts;
                                width: 86px;
                                height: 30px;
                            }
                            Text { text: "Transient network errors · exponential backoff, up to 4 min"; color: #727b92; font-size: 10px; vertical-alignment: center; }
                            Rectangle { horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            height: 32px;
                            Text { text: "Search"; color: #a1a8bb; font-size: 11px; vertical-alignment: center; }
                            Rectangle {
                                border-radius: 8px;
                                background: #0e111a;
                                border-width: 1px;
                                border-color: #343a4e;
                                horizontal-stretch: 1;
                                TextInput {
                                    text <=> root.history-search;
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    accessible-placeholder-text: "Search title, site, URL, status, or file path";
                                    color: #ecedf4;
                                    font-size: 12px;
                                    selection-background-color: #5751a3;
                                    vertical-alignment: center;
                                }
                                if root.history-search == "" : Text {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    height: parent.height;
                                    text: "Search title, site, URL, status, or file path";
                                    color: #727b92;
                                    font-size: 12px;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle {
                        background: #10131c;
                        border-width: 1px;
                        border-color: #252a3a;
                        border-radius: 13px;
                        vertical-stretch: 1;
                        clip: true;

                        VerticalLayout {
                            padding: 8px;
                            spacing: 0px;
                            if root.downloads.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 8px;
                                Text { text: root.history-search == "" ? "Your queue is clear" : "No matching downloads"; color: #d9dce7; font-size: 15px; font-weight: 600; horizontal-alignment: center; }
                                Text { text: root.history-search == "" ? "Paste a URL above to add a download." : "Try a title, site, URL, status, or file path."; color: #778099; font-size: 12px; horizontal-alignment: center; }
                            }
                            for row in root.downloads: Rectangle {
                                height: 86px;
                                background: #10131c;
                                border-color: #202536;
                                border-width: 0px;
                                HorizontalLayout {
                                    padding-top: 11px;
                                    padding-bottom: 11px;
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 12px;
                                    Rectangle {
                                        width: 42px;
                                        height: 42px;
                                        border-radius: 10px;
                                        background: #22263a;
                                        Text { text: "▶"; color: #aaa0ff; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 3px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text { text: row.title; color: #e4e6ef; font-size: 13px; font-weight: 600; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: row.status; color: row.status == "Completed" ? #74d6ae : row.status == "Waiting for retry" || row.status == "Waiting for schedule" ? #dfb86f : #9aa2b8; font-size: 11px; }
                                            if row.status == "Completed" && row.output-path != "" : Rectangle {
                                                width: 48px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Open"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.open-output-requested(row.output-path); } }
                                            }
                                            if row.status == "Failed" || row.status == "Interrupted" || row.status == "Canceled" : Rectangle {
                                                width: 48px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Retry"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.retry-download-requested(row.id); } }
                                            }
                                            if row.status == "Paused" : Rectangle {
                                                width: 54px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Resume"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.resume-download-requested(row.id); } }
                                            }
                                            if row.status == "Queued" || row.status == "Waiting for retry" || row.status == "Waiting for schedule" || row.status == "Analyzing" || row.status == "Downloading" || row.status == "Post-processing" : Rectangle {
                                                width: 54px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Pause"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.pause-download-requested(row.id); } }
                                            }
                                            if row.status == "Queued" || row.status == "Waiting for retry" || row.status == "Waiting for schedule" || row.status == "Paused" || row.status == "Analyzing" || row.status == "Downloading" || row.status == "Post-processing" || row.status == "Pausing" : Rectangle {
                                                width: 54px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Cancel"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.cancel-download-requested(row.id); } }
                                            }
                                            if row.status == "Completed" || row.status == "Failed" || row.status == "Canceled" || row.status == "Interrupted" : Rectangle {
                                                width: 54px;
                                                height: 24px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: "Remove"; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea { clicked => { root.remove-download-requested(row.id); } }
                                            }
                                        }
                                        Rectangle {
                                            height: 4px;
                                            border-radius: 2px;
                                            background: #282d3c;
                                            Rectangle {
                                                width: parent.width * row.progress / 100;
                                                height: parent.height;
                                                border-radius: 2px;
                                                background: #8778ff;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 5px;
                                            Text { text: row.detail; color: #757e97; font-size: 10px; overflow: elide; horizontal-stretch: 1; vertical-alignment: center; }
                                            if row.playlist-group-action != "" : Rectangle {
                                                width: 96px;
                                                height: 22px;
                                                border-radius: 6px;
                                                background: #252a39;
                                                Text { text: row.playlist-group-action; color: #c4c9d7; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                                                TouchArea {
                                                    clicked => {
                                                        root.playlist-group-action-requested(
                                                            row.playlist-group-id,
                                                            row.playlist-group-action == "Pause group" ? "pause" : "resume"
                                                        );
                                                    }
                                                }
                                            }
                                            if row.queue-position != "" : HorizontalLayout {
                                                spacing: 4px;
                                                Text { text: row.queue-position; color: #a9b0c4; font-size: 10px; vertical-alignment: center; }
                                                ActionButton { label: "↑"; button-height: 22px; button-min-width: 24px; clicked => { root.queue-move-requested(row.id, "up"); } }
                                                ActionButton { label: "↓"; button-height: 22px; button-min-width: 24px; clicked => { root.queue-move-requested(row.id, "down"); } }
                                                ActionButton { label: "Top"; button-height: 22px; button-min-width: 36px; clicked => { root.queue-move-requested(row.id, "top"); } }
                                                ActionButton { label: "Bottom"; button-height: 22px; button-min-width: 48px; clicked => { root.queue-move-requested(row.id, "bottom"); } }
                                                ActionButton {
                                                    label: row.priority == 1 ? "High" : "Normal";
                                                    button-height: 22px;
                                                    button-min-width: 52px;
                                                    clicked => { root.download-priority-requested(row.id, row.priority == 1 ? 0 : 1); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ClipboardPopup inherits Window {
    title: "Yt Save — copied link";
    preferred-width: 440px;
    preferred-height: 214px;
    min-width: 440px;
    min-height: 214px;
    no-frame: true;
    always-on-top: true;
    background: transparent;

    in-out property <string> candidate-url: "";
    in-out property <string> source-host: "";
    callback analyze-requested(string);
    callback add-video-requested(string);
    callback add-audio-requested(string);
    callback more-options-requested(string);
    callback dismiss-requested();

    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: parent.height - 16px;
        background: #151925;
        border-width: 1px;
        border-color: #3a4056;
        border-radius: 14px;

        VerticalLayout {
            padding: 16px;
            spacing: 8px;

            HorizontalLayout {
                height: 26px;
                spacing: 8px;
                Text { text: "Yt Save"; color: #a9b0c4; font-size: 11px; font-weight: 600; }
                Text { text: "Copied media link"; color: #f1f2f7; font-size: 15px; font-weight: 700; horizontal-stretch: 1; }
                ActionButton {
                    label: "×";
                    button-height: 28px;
                    button-min-width: 32px;
                    clicked => { root.dismiss-requested(); }
                }
            }

            Text {
                text: root.source-host;
                color: #d6d9e5;
                font-size: 12px;
                overflow: elide;
            }

            Text {
                text: "Nothing is analyzed or downloaded until you choose an action.";
                color: #8f98ae;
                font-size: 11px;
                overflow: elide;
            }

            HorizontalLayout {
                height: 34px;
                spacing: 7px;
                ActionButton {
                    label: "Analyze";
                    button-height: 34px;
                    button-min-width: 83px;
                    clicked => { root.analyze-requested(root.candidate-url); }
                }
                ActionButton {
                    label: "Add video";
                    button-height: 34px;
                    button-min-width: 83px;
                    primary: true;
                    clicked => { root.add-video-requested(root.candidate-url); }
                }
                ActionButton {
                    label: "Add audio";
                    button-height: 34px;
                    button-min-width: 83px;
                    clicked => { root.add-audio-requested(root.candidate-url); }
                }
            }

            HorizontalLayout {
                height: 24px;
                spacing: 12px;
                Text {
                    text: root.candidate-url;
                    color: #777f94;
                    font-size: 10px;
                    horizontal-stretch: 1;
                    overflow: elide;
                    vertical-alignment: center;
                }
                ActionButton {
                    label: "More options";
                    button-height: 24px;
                    button-min-width: 90px;
                    clicked => { root.more-options-requested(root.candidate-url); }
                }
            }
        }
    }
}

export component AppTray inherits SystemTrayIcon {
    in-out property <int> active-count: 0;
    in-out property <int> paused-count: 0;
    in property <string> tray-tooltip: "Yt Save";
    icon: @image-url("../../../assets/yt-save.png");
    tooltip: root.tray-tooltip;

    callback open-requested();
    callback hide-requested();
    callback pause-all-requested();
    callback resume-all-requested();
    callback open-folder-requested();
    callback quit-requested();

    clicked => { root.open-requested(); }

    Menu {
        MenuItem {
            title: "Open Yt Save";
            activated => { root.open-requested(); }
        }
        MenuItem {
            title: "Hide to tray";
            activated => { root.hide-requested(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Pause all downloads";
            enabled: root.active-count > 0;
            activated => { root.pause-all-requested(); }
        }
        MenuItem {
            title: "Resume paused downloads";
            enabled: root.paused-count > 0;
            activated => { root.resume-all-requested(); }
        }
        MenuSeparator { }
        MenuItem {
            title: "Open download folder";
            activated => { root.open-folder-requested(); }
        }
        MenuItem {
            title: "Quit Yt Save";
            activated => { root.quit-requested(); }
        }
    }
}
